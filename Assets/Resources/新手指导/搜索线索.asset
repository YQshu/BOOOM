  tutorialImage: {fileID: 0}
  tutorialText: "\u641C\u96C6\u7EBF\u7D22\n\u4F60\u641C\u96C6\u5230\u7684\u6240\u6709\u7EBF\u7D22\u90FD\u4F1A\u51FA\u73B0\u5728\u7EBF\u7D22\u5899\u4E2D\u3002\u5176\u4E2D\u6807\u6CE8\uFF01\u7684\u662F\u65B0\u641C\u96C6\u5230\u7684\u7EBF\u7D22\u3002\n\u5F53\u4F60\u641C\u96C6\u4E86\u5173\u4E8E\u67D0\u4E2A\u5ACC\u7591\u4EBA\u8DB3\u591F\u591A\u7684\u7EBF\u7D22\uFF0C\u4F60\u5C31\u53EF\u4EE5\u5F00\u59CB\u8C03\u67E5\u4E0B\u4E00\u4E2A\u5ACC\u7591\u4EBA\u3002"
