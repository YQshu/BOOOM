--- !u!114 &7332497010236545065
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 59cf9606573ab60468162b2a445b7625, type: 3}
  m_Name: DialogueClip
  m_EditorClassIdentifier: 
  dialogueLines:
  - speakerName: Hero
    dialogueText: Hello
    speakerPortrait: {fileID: -454471912, guid: c7d8f1b6c5611a1489cb0fb1bc446b3e, type: 3}
    customTypewriterSpeed: 0
  - speakerName: Reporter
    dialogueText: Hi
    speakerPortrait: {fileID: 1648206144, guid: c7d8f1b6c5611a1489cb0fb1bc446b3e, type: 3}
    customTypewriterSpeed: 0
  - speakerName: Hero
    dialogueText: As a journalist, you came way too early.
    speakerPortrait: {fileID: -454471912, guid: c7d8f1b6c5611a1489cb0fb1bc446b3e, type: 3}
    customTypewriterSpeed: 0
  - speakerName: Reporter
    dialogueText: Our work values timeliness. So, tell me, what happened this time?
    speakerPortrait: {fileID: 1648206144, guid: c7d8f1b6c5611a1489cb0fb1bc446b3e, type: 3}
    customTypewriterSpeed: 0
  - speakerName: Hero
    dialogueText: Wait for me to brush my teeth and wash my face, then I'll take
      you to the scene
    speakerPortrait: {fileID: -454471912, guid: c7d8f1b6c5611a1489cb0fb1bc446b3e, type: 3}
    customTypewriterSpeed: 0
  enableTypewriter: 1
  typewriterSpeed: 0.01
  allowClickToSkip: 1
