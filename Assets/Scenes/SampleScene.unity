    endingTextHasty: "\xB7\u4F60\u8349\u8349\u6307\u8BA4\u4E86\u827E\u62C9\u4E3A\u51F6\u624B\u2014\u2014\u54EA\u6015\u4F60\u8FD8\u6CA1\u6709\u8C03\u67E5\u8FC7\uFF08\u8FD9\u91CC\u662F\u73A9\u5BB6\u5C1A\u4E14\u6CA1\u6709\u8C03\u67E5\u7684\u89D2\u8272\u540D\uFF09\u3002\n\xB7\u5979\u53EF\u7591\u5417\uFF1F\u4E5F\u8BB8\u5427\uFF0C\u5979\u5BC6\u8C0B\u8C0B\u6740\u6C83\u514B\u7684\u8BA1\u5212\u88AB\u4EBA\u542C\u89C1\u3001\u5C1D\u8BD5\u4E32\u901A\u9152\u5427\u91CC\u7684\u6BCF\u4E00\u4E2A\u4EBA\uFF0C\u8FD8\u6709\u79CD\u79CD\u65E0\u6CD5\u8FA9\u62A4\u7684\u7EC6\u8282\uFF0C\u90FD\u503C\u5F97\u4F60\u7684\u6000\u7591\u3002\n\xB7\u5979\u6CA1\u6709\u628A\u4F60\u4F9B\u51FA\u6765\uFF0C\u5C3D\u7BA1\u4F60\u672C\u8BE5\u4F5C\u4E3A\u5171\u72AF\u88AB\u6355\u3002\u76F4\u5230\u4EBA\u95F4\u84B8\u53D1\uFF0C\u5979\u90FD\u4EE5\u4E3A\u4F60\u7684\u8C03\u67E5\u51FA\u73B0\u4E86\u610F\u5916\u2014\u2014\u8FD9\u4E0D\u662F\u4F60\u4EEC\u5546\u91CF\u597D\u7684\u7ED3\u5C40\u3002\n\xB7\u540E\u6765\uFF0C\u6770\u65AF\u7684\u9152\u5427\u7167\u5E38\u8425\u4E1A\uFF0C\u827E\u62C9\u4ECE\u76D1\u72F1\u91CC\u4EBA\u95F4\u84B8\u53D1\uFF0C\u51EF\u7EE7\u7EED\u505A\u4ED6\u7684\u4E49\u4F53\u533B\u751F\uFF0C\u8D24\u53F8\u63A5\u7740\u8FC7\u4ED6\u5200\u53E3\u8214\u8840\u7684\u65E5\u5B50\u3002\n\xB7\u516C\u53F8\u7684\u4F20\u7EDF\u6D3E\u4E0E\u5F3A\u786C\u6D3E\u4F9D\u65E7\u4E89\u6267\u4E0D\u4E0B\uFF0C\u81EA\u7531\u90A6\u8FDE\u4E0E\u8054\u90A6\u653F\u5E9C\u8F6E\u6D41\u5728\u65B0\u6D1B\u6749\u77F6\u65BD\u653E\u7740\u81EA\u5DF1\u7684\u5F71\u54CD\u529B\u2014\u2014\u5F80\u5F80\u662F\u4EE5\u89C1\u8840\u7684\u65B9\u5F0F\u3002"
    endingTextThorough: "\xB7\u7ECF\u8FC7\u8003\u8651\uFF0C\u4F60\u6307\u8BA4\u4E86\u827E\u62C9\u4E3A\u51F6\u624B\u2014\u2014\u5979\u4E0D\u5F97\u4E0D\u505A\u4F60\u7684\u66FF\u7F6A\u7F8A\u3002\n\xB7\u5979\u53EF\u7591\u5417\uFF1F\u5F53\u7136\uFF01\u5979\u5BC6\u8C0B\u8C0B\u6740\u6C83\u514B\u7684\u8BA1\u5212\u88AB\u4EBA\u542C\u89C1\u3001\u5C1D\u8BD5\u4E32\u901A\u9152\u5427\u91CC\u7684\u6BCF\u4E00\u4E2A\u4EBA\uFF0C\u8FD8\u6709\u5979\u690D\u5165\u75C5\u6BD2\u7684\u5168\u90E8\u8FC7\u7A0B\uFF0C\u90FD\u88AB\u4F60\u63D0\u4EA4\u7ED9\u8B66\u7F72\uFF0C\u5B9A\u5979\u7684\u7F6A\u51E0\u4E4E\u6CA1\u6709\u4EC0\u4E48\u56F0\u96BE\u3002\n\xB7\u5979\u6CA1\u6709\u628A\u4F60\u4F9B\u51FA\u6765\uFF0C\u5C3D\u7BA1\u4F60\u672C\u8BE5\u4F5C\u4E3A\u5171\u72AF\u88AB\u6355\uFF0C\u800C\u6307\u5411\u4F60\u7684\u7EBF\u7D22\u4E5F\u88AB\u4F60\u8F7B\u677E\u63A9\u76D6\u3002\u76F4\u5230\u4EBA\u95F4\u84B8\u53D1\uFF0C\u5979\u90FD\u4EE5\u4E3A\u4F60\u7684\u8C03\u67E5\u51FA\u73B0\u4E86\u610F\u5916\u2014\u2014\u8FD9\u4E0D\u662F\u4F60\u4EEC\u5546\u91CF\u597D\u7684\u7ED3\u5C40\u3002\n\xB7\u540E\u6765\uFF0C\u9664\u4F60\u4E4B\u5916\u7684\u6240\u6709\u4EBA\u90FD\u88AB\u8BA4\u4E3A\u662F\u8FD9\u573A\u8C0B\u6740\u7684\u5E2E\u51F6\uFF0C\u6770\u65AF\u88AB\u8FEB\u6539\u540D\u6613\u59D3\u6F5C\u9003\u5948\u7279\u57CE\uFF0C\u800C\u827E\u62C9\u4E0D\u4E45\u5C31\u4ECE\u76D1\u72F1\u91CC\u4EBA\u95F4\u84B8\u53D1\uFF0C\u51EF\u53D7\u5230\u516C\u53F8\u4E24\u6D3E\u7684\u8FFD\u6740\u540E\u9500\u58F0\u533F\u8FF9\uFF0C\u8D24\u53F8\u906D\u5230\u98DE\u8F66\u626B\u5C04\u6A2A\u6B7B\u8857\u5934\u2014\u2014\u4F60\u90FD\u5E72\u4E86\u4EC0\u4E48\uFF1F\n\xB7\u516C\u53F8\u7684\u4E24\u6D3E\u56E0\u4E3A\u6C83\u514B\u7684\u6B7B\u5C55\u5F00\u4E86\u8C08\u5224\uFF0C\u6570\u5E74\u540E\u7EC8\u4E8E\u8FCE\u6765\u4E86\u7EDF\u4E00\uFF0C\u73AF\u7403\u901A\u7528\u6280\u672F\u5F00\u59CB\u5411\u6574\u4E2A\u81EA\u7531\u90A6\u8FDE\u751A\u81F3\u8054\u90A6\u62D3\u5C55\u5F71\u54CD\u529B\uFF0C\u4E0B\u4E00\u6B21\u516C\u53F8\u6218\u4E89\uFF0C\u5B83\u6CE8\u5B9A\u8981\u5927\u663E\u8EAB\u624B\u3002"
