    endingTextHasty: "\xB7\u4F60\u8349\u8349\u6307\u8BA4\u4E86\u8D24\u53F8\u4E3A\u51F6\u624B\u2014\u2014\u54EA\u6015\u4F60\u8FD8\u6CA1\u6709\u8C03\u67E5\u8FC7\uFF08\u8FD9\u91CC\u662F\u73A9\u5BB6\u5C1A\u4E14\u6CA1\u6709\u8C03\u67E5\u7684\u89D2\u8272\u540D\uFF09\u3002\n\xB7\u4ED6\u53EF\u7591\u5417\uFF1F\u4E5F\u8BB8\u5427\uFF0C\u827E\u62C9\u4E0E\u51EF\u4E3A\u4EC0\u4E48\u90FD\u8BF4\u4ED6\u8981\u6740\u5BB3\u6C83\u514B\uFF1F\u4ED6\u7684\u5BC6\u94A5\u4E3A\u4EC0\u4E48\u65E0\u6545\u5916\u6CC4\u5230\u51F6\u624B\u624B\u91CC\uFF1F\u4ED6\u4E3A\u4EC0\u4E48\u7834\u574F\u4E86\u73B0\u573A\uFF1F\u6CA1\u6709\u4EBA\u77E5\u9053\u4E3A\u4EC0\u4E48\uFF0C\u4F46\u4E00\u4E2A\u5200\u53E3\u8214\u8840\u7684\u96C7\u4F63\u5175\u4E0D\u503C\u5F97\u4ED6\u4EEC\u601C\u60AF\u3002\n\xB7\u540E\u6765\u4F60\u542C\u8BF4\uFF0C\u4ED6\u5728\u88AB\u902E\u6355\u540E\u6307\u8BA4\u4E86\u4F60\u7684\u8C0B\u6740\uFF0C\u53EF\u4ED6\u6709\u4EC0\u4E48\u8BC1\u636E\u5462\uFF1F\u4F60\u8F7B\u800C\u6613\u4E3E\u5730\u5C31\u7528\u6251\u6714\u8FF7\u79BB\u7684\u6848\u60C5\u8499\u853D\u4E86\u68C0\u5BDF\u5B98\uFF0C\u8BA9\u8FD9\u4EF6\u4E8B\u770B\u4E0A\u53BB\u548C\u4F60\u6CA1\u6709\u4E00\u70B9\u5173\u7CFB\uFF0C\u800C\u4ED6\u662F\u552F\u4E00\u4E00\u4E2A\u6536\u94B1\u529E\u4E8B\u7684\u51F6\u624B\u3002\n\xB7\u540E\u6765\uFF0C\u6770\u65AF\u7684\u9152\u5427\u7167\u5E38\u8425\u4E1A\uFF0C\u827E\u62C9\u7EE7\u7EED\u7740\u5979\u7684\u8BB0\u8005\u751F\u6DAF\uFF0C\u51EF\u7EE7\u7EED\u505A\u4ED6\u7684\u4E49\u4F53\u533B\u751F\uFF0C\u8D24\u53F8\u5728\u88AB\u902E\u6355\u540E\u4E0D\u4E45\u5C31\u88AB\u4EBA\u706D\u53E3\u3002\n\xB7\u516C\u53F8\u7684\u4F20\u7EDF\u6D3E\u4E0E\u5F3A\u786C\u6D3E\u4F9D\u65E7\u4E89\u6267\u4E0D\u4E0B\uFF0C\u81EA\u7531\u90A6\u8FDE\u4E0E\u8054\u90A6\u653F\u5E9C\u8F6E\u6D41\u5728\u65B0\u6D1B\u6749\u77F6\u65BD\u653E\u7740\u81EA\u5DF1\u7684\u5F71\u54CD\u529B\u2014\u2014\u5F80\u5F80\u662F\u4EE5\u89C1\u8840\u7684\u65B9\u5F0F\u3002"
    endingTextThorough: "\xB7\u7ECF\u8FC7\u8003\u8651\uFF0C\u4F60\u6307\u8BA4\u8D24\u53F8\u4E3A\u51F6\u624B\u2014\u2014\u4ED6\u4E0D\u5F97\u4E0D\u505A\u90A3\u53EA\u66FF\u7F6A\u7F8A\u3002\n\xB7\u4ED6\u53EF\u7591\u5417\uFF1F\u5F53\u7136\uFF01\u4ED6\u9ED1\u5165\u4E86\u540E\u53F0\u3001\u6295\u653E\u4E86\u75C5\u6BD2\u3001\u88AB\u5B89\u6392\u8C0B\u6740\u6C83\u514B\u3001\u6CC4\u9732\u5BC6\u94A5\u3001\u7834\u574F\u73B0\u573A\uFF0C\u8FD8\u6709\u4E00\u5806\u4E71\u4E03\u516B\u7CDF\u7684\u8BC1\u636E\u4EE5\u53CA\u52A3\u8FF9\u7D2F\u7D2F\u7684\u524D\u79D1\u6765\u8BA9\u4ED6\u7684\u5F8B\u5E08\u5FD9\u4E0A\u4E00\u8F88\u5B50\u3002\n\xB7\u540E\u6765\u4F60\u542C\u8BF4\uFF0C\u4ED6\u5728\u88AB\u902E\u6355\u540E\u6307\u8BA4\u4E86\u4F60\u7684\u8C0B\u6740\uFF0C\u53EF\u4ED6\u6709\u4EC0\u4E48\u8BC1\u636E\u5462\uFF1F\u4F60\u8F7B\u800C\u6613\u4E3E\u5730\u5C31\u7528\u6251\u6714\u8FF7\u79BB\u7684\u6848\u60C5\u548C\u65E0\u6BD4\u4E30\u5BCC\u7684\u8BC1\u636E\u8499\u853D\u4E86\u68C0\u5BDF\u5B98\uFF0C\u8BA9\u8FD9\u4EF6\u4E8B\u770B\u4E0A\u53BB\u548C\u4F60\u6CA1\u6709\u4E00\u70B9\u5173\u7CFB\uFF0C\u800C\u4ED6\u662F\u552F\u4E00\u4E00\u4E2A\u6536\u94B1\u529E\u4E8B\u7684\u51F6\u624B\u3002\n\xB7\u540E\u6765\uFF0C\u6770\u65AF\u7684\u9152\u5427\u7167\u5E38\u8425\u4E1A\uFF0C\u827E\u62C9\u7EE7\u7EED\u7740\u5979\u7684\u8BB0\u8005\u751F\u6DAF\uFF0C\u51EF\u7EE7\u7EED\u505A\u4ED6\u7684\u4E49\u4F53\u533B\u751F\uFF0C\u8D24\u53F8\u5728\u88AB\u902E\u6355\u540E\u4E0D\u4E45\u5C31\u88AB\u4EBA\u706D\u53E3\u3002\n\xB7\u516C\u53F8\u5F3A\u786C\u6D3E\u9677\u5165\u8C0B\u6740\u7684\u6CE5\u6F6D\uFF0C\u4F20\u7EDF\u6D3E\u63A5\u7BA1\u4E86\u65B0\u6D1B\u6749\u77F6\uFF0C\u4ED6\u4EEC\u575A\u51B3\u7AD9\u5728\u8054\u90A6\u7684\u4E00\u8FB9\uFF0C\u5E26\u9886\u65B0\u6D1B\u6749\u77F6\u56DE\u5F52\u4E86\u8054\u90A6\u3002\u81EA\u7531\u5DDE\u90A6\u8054\u52C3\u7136\u5927\u6012\uFF0C\u7B2C\u516D\u6B21\u516C\u53F8\u6218\u4E89\u4E0D\u4E45\u5C31\u5728\u65B0\u6D1B\u6749\u77F6\u7206\u53D1\u3002"
